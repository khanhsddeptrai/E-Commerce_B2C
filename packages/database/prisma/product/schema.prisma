datasource db {
  provider = "postgresql"
  url      = env("PRODUCT_DATABASE_URL")
}

generator productClient {
  provider = "prisma-client-js"
  output   = "../../src/generated/product-client"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------- Quản lý kho (WMS) – xem docs/06-wms-implementation-plan.md ----------

enum ReservationStatus {
  HOLD // Giữ hàng chờ thanh toán (có hạn)
  COMMITTED // Đã chốt đơn, chưa xuất kho
  RELEASED // Đã nhả (hết hạn / thanh toán thất bại / hủy trước khi xuất)
  SHIPPED // Đã xuất kho
}

enum InventoryTransactionType {
  INBOUND // Nhập kho (phiếu nhập, tồn đầu kỳ)
  OUTBOUND // Xuất kho giao đơn
  RETURN // Nhận lại hàng hoàn
  ADJUSTMENT // Điều chỉnh kiểm kê
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(180)
  description  String?  @db.Text
  icon         String?  @db.VarChar(50)
  imageUrl     String?  @map("image_url") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(180)
  logoUrl   String?  @map("logo_url") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String?       @map("brand_id") @db.Uuid
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name           String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(280)
  tagline        String?       @db.VarChar(500)
  description    String        @db.Text
  thumbnailUrl   String        @map("thumbnail_url") @db.Text
  basePrice      Decimal       @map("base_price") @db.Decimal(15, 2)
  originalPrice  Decimal?      @map("original_price") @db.Decimal(15, 2)
  featured       Boolean       @default(false)
  isFlashSale    Boolean       @default(false) @map("is_flash_sale")
  flashSaleSold  Int           @default(0) @map("flash_sale_sold")
  flashSaleTotal Int           @default(0) @map("flash_sale_total")
  rating         Decimal       @default(5.0) @db.Decimal(3, 1)
  reviewCount    Int           @default(0) @map("review_count")
  badge          String?       @db.VarChar(100)
  status         ProductStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  images ProductImage[]
  skus   ProductSku[]
  specs  ProductSpec[]

  @@index([categoryId])
  @@index([brandId])
  @@index([featured])
  @@index([isFlashSale])
  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String  @map("image_url") @db.Text
  displayOrder Int     @default(0) @map("display_order")
  isThumbnail  Boolean @default(false) @map("is_thumbnail")

  @@index([productId])
  @@map("product_images")
}

model ProductSku {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuCode       String   @unique @map("sku_code") @db.VarChar(100)
  name          String   @db.VarChar(200)
  colorName     String   @map("color_name") @db.VarChar(100)
  colorHex      String   @map("color_hex") @db.VarChar(20)
  price         Decimal  @db.Decimal(15, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(15, 2)
  imageUrl      String?  @map("image_url") @db.Text
  specs         Json?    @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inventoryStocks       InventoryStock[]
  inventoryReservations InventoryReservation[]
  inventoryTransactions InventoryTransaction[]
  receiptItems          InventoryReceiptItem[]

  @@index([productId])
  @@map("product_skus")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  address   String?  @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks       InventoryStock[]
  reservations InventoryReservation[]
  transactions InventoryTransaction[]
  receipts     InventoryReceipt[]

  @@map("warehouses")
}

// Tồn kho của 1 SKU tại 1 kho. Còn bán được = onHand − reserved − (tổng HOLD còn hạn)
model InventoryStock {
  id          String     @id @default(uuid()) @db.Uuid
  skuId       String     @map("sku_id") @db.Uuid
  sku         ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId String     @map("warehouse_id") @db.Uuid
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  onHand      Int        @default(0) @map("on_hand") // Tồn vật lý trong kho
  reserved    Int        @default(0) // Đã chốt đơn, chưa xuất kho
  version     Int        @default(0) // Optimistic locking
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([skuId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_stocks")
}

// Giữ hàng theo đơn (chuyển từ order_db sang). Mỗi đơn có tối đa 1 dòng cho mỗi SKU tại mỗi kho
model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  orderCode   String            @map("order_code") @db.VarChar(50)
  skuId       String            @map("sku_id") @db.Uuid
  sku         ProductSku        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId String            @map("warehouse_id") @db.Uuid
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Int
  status      ReservationStatus @default(HOLD)
  expiresAt   DateTime?         @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([orderId, skuId, warehouseId])
  @@index([skuId, status])
  @@index([status, expiresAt])
  @@index([orderCode])
  @@map("inventory_reservations")
}

// Sổ xuất – nhập – tồn: chỉ thêm, không sửa / xóa
model InventoryTransaction {
  id           String                   @id @default(uuid()) @db.Uuid
  skuId        String                   @map("sku_id") @db.Uuid
  sku          ProductSku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouseId  String                   @map("warehouse_id") @db.Uuid
  warehouse    Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type         InventoryTransactionType
  quantity     Int // Dương: tăng tồn, âm: giảm tồn
  balanceAfter Int                      @map("balance_after") // onHand sau giao dịch
  refType      String                   @map("ref_type") @db.VarChar(30) // OPENING | RECEIPT | ORDER | ADJUSTMENT
  refId        String                   @map("ref_id") @db.VarChar(100) // Mã phiếu nhập / mã đơn / mã điều chỉnh
  note         String?                  @db.Text
  createdBy    String                   @map("created_by") @db.VarChar(100)
  createdAt    DateTime                 @default(now()) @map("created_at")

  // Chống ghi trùng khi một thao tác được gọi lại (retry / idempotency)
  @@unique([refType, refId, type, skuId, warehouseId])
  @@index([skuId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_transactions")
}

// Phiếu nhập kho từ nhà cung cấp
model InventoryReceipt {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(30) // GRN-YYMMDD-XXXX
  warehouseId  String    @map("warehouse_id") @db.Uuid
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplierName String?   @map("supplier_name") @db.VarChar(200)
  note         String?   @db.Text
  createdBy    String    @map("created_by") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")

  items InventoryReceiptItem[]

  @@index([createdAt])
  @@map("inventory_receipts")
}

model InventoryReceiptItem {
  id        String           @id @default(uuid()) @db.Uuid
  receiptId String           @map("receipt_id") @db.Uuid
  receipt   InventoryReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  skuId     String           @map("sku_id") @db.Uuid
  sku       ProductSku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  quantity  Int
  costPrice Decimal          @map("cost_price") @db.Decimal(15, 2) // Giá vốn nhập

  @@unique([receiptId, skuId])
  @@map("inventory_receipt_items")
}

model ProductSpec {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String  @db.VarChar(100)
  value        String  @db.VarChar(255)
  displayOrder Int     @default(0) @map("display_order")

  @@index([productId])
  @@map("product_specs")
}
