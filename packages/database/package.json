{
  "name": "@repo/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:product:generate": "prisma generate --schema=prisma/schema-product.prisma",
    "db:product:migrate": "prisma migrate dev --schema=prisma/schema-product.prisma",
    "db:product:seed": "node prisma/seed-products.js",
    "db:product:seed-all": "node prisma/seed-products.js && node prisma/seed-new-items.js && node prisma/seed-aula-variants.js && node prisma/update-aula-images.js",
    "db:order:generate": "prisma generate --schema=prisma/schema-order.prisma",
    "db:order:migrate": "prisma migrate dev --schema=prisma/schema-order.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "typescript": "^5.7.0"
  }
}
