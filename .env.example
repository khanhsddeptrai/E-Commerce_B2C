# Database URLs (PostgreSQL)
AUTH_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/auth_db?schema=public"
PRODUCT_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/product_db?schema=public"
ORDER_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/order_db?schema=public"
PAYMENT_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/payment_db?schema=public"

# Cache & Lock (Redis)
REDIS_URL="redis://localhost:6379"

# Message Broker (RabbitMQ)
RABBITMQ_URL="amqp://admin:admin123@localhost:5672"

# NoSQL Chat Database (MongoDB)
MONGODB_URL="mongodb://localhost:27017/chat_db"

# Search Engine (Meilisearch)
MEILISEARCH_URL="http://localhost:7700"
# Phải trùng MEILI_MASTER_KEY trong docker/docker-compose.yml
MEILISEARCH_KEY="change-me-meilisearch-master-key"

# JWT Authentication Secrets
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me-access-secret"
# Khác JWT_ACCESS_SECRET
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Service Ports & Networking
PORT_API_GATEWAY=8000
AUTH_GRPC_PORT=50051
AUTH_GRPC_HOST="0.0.0.0"
AUTH_GRPC_URL="localhost:50051"

# VNPAY Sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg – bắt buộc, payment-service không khởi động nếu thiếu)
VNPAY_TMN_CODE="your-vnpay-tmn-code"
VNPAY_HASH_SECRET="your-vnpay-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/checkout/payment-result"
